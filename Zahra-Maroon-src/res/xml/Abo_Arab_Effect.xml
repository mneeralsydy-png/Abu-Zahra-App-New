<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================ -->
    <!-- 🤖 الأدوات الذكية (Smart Tools) -->
    <!-- ================================ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/auto_Replay_schdulr">
        <Preference
            android:icon="@drawable/abo_arab_ic_autoreply"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/msg_autoreply_title"
            android:summary="@string/acjauto_R">
            <intent
                android:targetPackage="com.zahra.whatsapp"
                android:targetClass="com.whatsapp.yo.autoschedreply.Auto_message" />
        </Preference>
        <Preference
            android:icon="@drawable/abo_arab_ic_message_schedule"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/msg_scheduler_title"
            android:summary="@string/acjschdulr_S">
            <intent
                android:targetPackage="com.zahra.whatsapp"
                android:targetClass="com.whatsapp.yo.autoschedreply.ListMessages" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/mas_quickreplies">
        <Preference
            android:icon="@drawable/abo_arab_ic_quick_replies"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/mas_quickreplies"
            android:summary="@string/quickreplies_abu_arab">
            <intent
                android:targetPackage="com.zahra.whatsapp"
                android:targetClass="abu3arab.quickreply.QuickReplyActivity" />
        </Preference>
    </PreferenceCategory>

    <!-- ====================================== -->
    <!-- 📨 أدوات الرسائل (Messaging Tools) -->
    <!-- ====================================== -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="أدوات الرسائل">
        <SwitchPreference
            android:icon="@drawable/abu_arab_icon_bubbles"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_extsendz"
            android:key="key_send_hidden_msg"
            android:summary="@string/abu_arab_extsendzz"
            android:defaultValue="false" />
        <EditTextPreference
            android:icon="@drawable/abo_arab_hidenotifs"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/abu_arab_extltz"
            android:key="key_edit_hidden_msg"
            android:summary="@string/abu_arab_exthiddenz"
            android:dependency="key_send_hidden_msg"
            android:defaultValue="@string/abu_arab_exthiddenz"
            android:dialogTitle="@string/abu_arab_extltz" />
        <SwitchPreference
            android:icon="@drawable/abu_arab_chatmredoc"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_extra_blanktxt"
            android:key="key_all_white"
            android:summary="@string/abu_arab_extra_blanktxt_sum"
            android:defaultValue="false" />
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_docsend"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_settz_extnosendz"
            android:key="key_notsend_msg"
            android:summary="@string/abu_arab_settz_extnosendz_sum"
            android:defaultValue="false" />
        <SwitchPreference
            android:icon="@drawable/abu_arab_docsend"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_settz_extnorecptz"
            android:key="key_notreceive_msg"
            android:summary="@string/abu_arab_settz_extnorecptz_sum"
            android:defaultValue="false" />
        <SwitchPreference
            android:icon="@drawable/abo_arab_imagehidden"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_settz_extnorecptimgz"
            android:key="key_noreceive_img"
            android:summary="@string/abu_arab_settz_extnorecptimgz_sum"
            android:defaultValue="false" />
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_mentionborder"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/aboarab_gpmention"
            android:key="aboarab_mention_member"
            android:summary="@string/aboarab_gpmention_sum"
            android:defaultValue="false" />
        <EditTextPreference
            android:icon="@drawable/abo_arab_ic_mentionborder"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/abu_arab_extraz_menreplyz"
            android:key="key_reply_mention"
            android:summary="@string/abu_arab_extraz_menreplyzz"
            android:dialogTitle="@string/abu_arab_extraz_menreplyz"
            android:dialogMessage="@string/abu_arab_extraz_menreplyzzz" />
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_group"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_fix_group_exitend"
            android:key="key_method_endgp"
            android:summary="@string/abu_arab_fix_group_exitend_sum"
            android:defaultValue="false" />
        <SwitchPreference
            android:icon="@drawable/abo_arab_namehidden"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/abu_arab_settz_extunsavz"
            android:key="key_hide_unsaved_num"
            android:summary="@string/abu_arab_settz_extunsavz_sum"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- ===================================== -->
    <!-- 🔧 أدوات متقدمة (Advanced Tools) -->
    <!-- ===================================== -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/massmsgr_title">
        <Preference
            android:icon="@drawable/abo_arab_ic_massmsger"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/massmsgr_title"
            android:summary="@string/massmsgr_title_abu_arab">
            <intent
                android:targetPackage="com.zahra.whatsapp"
                android:targetClass="com.whatsapp.yo.massmsger.SavedCollections" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/blocked_you_menu">
        <Preference
            android:icon="@drawable/abo_arab_ic_viewonce"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/blocked_you_menu"
            android:summary="@string/blocked_you_menu_abu_arab">
            <intent
                android:targetPackage="com.zahra.whatsapp"
                android:targetClass="abu3arab.mas.block.BlockListActivity" />
        </Preference>
    </PreferenceCategory>

    <!-- ========================================= -->
    <!-- 🔒 تشفير الرسائل (Message Encryption) -->
    <!-- ========================================= -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/mesaj_sifreleme_panel">
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_privspec"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/mesaj_sifreleme_etkin"
            android:key="mesaj_sifreleme_etkin"
            android:defaultValue="false"
            android:summaryOn="@string/mesaj_sifreleme_etkin_a"
            android:summaryOff="@string/mesaj_sifreleme_etkin_b" />
        <EditTextPreference
            android:icon="@drawable/abo_arab_ic_decrypyy"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/mesaj_sifreleme_sifredegistir_1"
            android:key="mas_cozumleme_parolasi"
            android:summary="@string/mesaj_sifreleme_sifredegistir_2"
            android:defaultValue="12345"
            android:dialogTitle="@string/mesaj_sifreleme_sifredegistir_1" />
        <com.whatsapp.yo.ColorPref
            android:icon="@drawable/abo_arab_ic_customimg"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/mesaj_sifreleme_panel_arkaplan"
            android:key="SifreArkaplan" />
        <com.whatsapp.yo.ColorPref
            android:icon="@drawable/abo_arab_ic_deslizar"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/mesaj_sifreleme_panel_metin1"
            android:key="MesajSifrelemeBaslikRengi" />
        <com.whatsapp.yo.ColorPref
            android:icon="@drawable/abo_arab_ic_toastext"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/mesaj_sifreleme_panel_metin"
            android:key="MesajSifrelemeMetinRengi" />
        <com.whatsapp.yo.ColorPref
            android:icon="@drawable/abo_arab_ic_viewonce"
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/mesaj_sifreleme_panel_goz"
            android:key="ParolaGozRengi" />
    </PreferenceCategory>

    <!-- ================================= -->
    <!-- ✨ التأثيرات (Effects) -->
    <!-- ================================= -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/Abo_Arab_Effects">
        <ListPreference
            android:icon="@drawable/abo_arab_ic_homeguias"
            android:entries="@array/transformer_entry"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/title_pref_transformer"
            android:key="key_pager_animation"
            android:summary="%s"
            android:defaultValue="0"
            android:entryValues="@array/transformer_value" />
        <ListPreference
            android:icon="@drawable/abo_arab_ic_homechata"
            android:entries="@array/listanimation_entry"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/chats_list_animations"
            android:key="key_chats_listanimation"
            android:summary="%s"
            android:defaultValue="0"
            android:entryValues="@array/listanimation_value" />
        <ListPreference
            android:icon="@drawable/abo_arab_ic_conversationeffect"
            android:entries="@array/listanimation_entry"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/chat_list_animations"
            android:key="key_chat_animation"
            android:summary="%s"
            android:defaultValue="0"
            android:entryValues="@array/listanimation_value" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="@string/abu_arab_snow_hctitle">
        <Preference
            android:icon="@drawable/abo_arab_ic_snow_effect"
            android:layout="@layout/abu_arab_preference_cevron"
            android:title="@string/abu_arab_snow_hctitle"
            android:summary="@string/abu_arab_snow_hctitle_sum">
            <intent
                android:targetPackage="com.zahra.whatsapp"
                android:action="android.intent.action.VIEW"
                android:targetClass="abu3arab.snowfalling.xml.snow_xml" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
