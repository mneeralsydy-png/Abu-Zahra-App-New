<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    android:title="@string/settings_privacy"
    android:summary="@string/yoPrivacySum"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  تنبيه مهم - Important Warning                             ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="⚠️ تنبيه مهم">
        <Preference
            android:layout="@layout/abu_arab_preference_layout"
            android:title="@string/yoPrivacySum"
            android:summary="إذا واجهت مشاكل في الرسائل أو الحالات، جرب إعادة ضبط إعدادات الخصوصية أو أعد تشغيل التطبيق"
            android:selectable="false" />
    </PreferenceCategory>

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  الخصوصية العامة - General Privacy                         ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="🔐 الخصوصية العامة">

        <!-- إخفاء آخر ظهور -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_freezer"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoHideSeen"
            android:title="@string/yoHideSeen"
            android:summary="@string/yoHideSeenSum"
            android:defaultValue="false" />

        <!-- تجاوز المشاهدة لمرة واحدة -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_viewonce"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="anti_vw_once"
            android:title="@string/antiviewonce"
            android:summary="@string/antiviewonceS"
            android:defaultValue="true" />

        <!-- إخفاء علامة التحويل -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_enc"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoDisableFwd"
            android:title="@string/yoDisableFwd"
            android:summary="@string/yoDisableFwdS"
            android:defaultValue="true" />

        <!-- إخفاء عداد رسائل المجموعة -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_hidec"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="hideGroupCounter"
            android:title="@string/abu_arab_hidecount_title"
            android:summary="@string/abu_arab_hidecount_title_sum"
            android:defaultValue="false" />

        <!-- الدردشات غير المقروءة -->
        <SwitchPreference
            android:icon="@drawable/mesaj_sifreleme"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="abu_arab_unreaded_chat"
            android:title="@string/abu_arab_unreaded_chat"
            android:summary="@string/abu_arab_unreaded_chat_sum"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  الحالات - Status / Stories                               ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="👁️ الحالات"
        android:key="stat_cat">

        <!-- إخفاء القنوات -->
        <SwitchPreference
            android:icon="@drawable/ic_abu3arab_channel"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="abu_arab_channels"
            android:title="@string/abu_arab_disable_channels"
            android:summary="@string/abu_arab_disable_channels_sum"
            android:defaultValue="false" />

        <!-- إخفاء مشاهدة الحالات -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_offstats"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoHideStatViewV2"
            android:title="@string/yoHideStatusView"
            android:summary="@string/yoHideStatusViewSum"
            android:defaultValue="true" />

        <!-- منع حذف الحالات -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_statdel"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoAntiRevokeStatus"
            android:title="@string/yoAntiRevokeStatus"
            android:summary="@string/yoAntiRevokeStatusS"
            android:defaultValue="true" />

        <!-- إخفاء زر إعادة نشر الحالات -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_repost"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="abuarabrepost"
            android:title="@string/abu_arab_repost"
            android:summary="@string/abu_arab_repost_sum"
            android:defaultValue="true" />

        <!-- إخفاء زر تحميل الحالات -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_hidownload"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoHideDlBtn"
            android:title="@string/yoHideDlBtn"
            android:summary="@string/yoHideDlBtn_sum"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  الدردشات - Chat Privacy                                  ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="💬 الدردشات">

        <!-- منع حذف الرسائل ذاتية الاختفاء -->
        <SwitchPreference
            android:icon="@drawable/abu_arab_ic_time"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="disappearing_message_key"
            android:title="@string/abu_arab_dm"
            android:summary="@string/abu_arab_dm_sum"
            android:defaultValue="true" />

        <!-- إظهار الرسالة المعدلة -->
        <SwitchPreference
            android:icon="@drawable/abu_arab_ic_contact"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="key_chat_editview"
            android:title="@string/abu_arab_seeditedz"
            android:summary="@string/abu_arab_seeditedz_sum"
            android:defaultValue="true" />

        <!-- منع حذف الرسائل -->
        <SwitchPreference
            android:icon="@drawable/abu_arab_ic_down"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoAntiRevoke"
            android:title="@string/yoAntiRevoke"
            android:summary="@string/yoAntiRevokeS"
            android:defaultValue="true" />

        <!-- الحذف لدى الجميع -->
        <SwitchPreference
            android:icon="@drawable/abu_arab_ic_time"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="masdeletionofeveryone"
            android:title="@string/abuarabdeleteeveryone"
            android:summary="@string/abuarabdeleteeveryones"
            android:defaultValue="true" />

        <!-- إظهار تاريخ الرسائل والحالات المحذوفة -->
        <SwitchPreference
            android:icon="@drawable/abu_arab_ic_backup"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="key_show_deltime"
            android:title="@string/abu_arab_settz_deltimez"
            android:summary="@string/abu_arab_settz_deltimezz"
            android:defaultValue="false" />

        <!-- إظهار صحين الازرق فقط بعد الرد -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_privtick"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="yoBlueOnReply"
            android:title="@string/yoBlueOnReply"
            android:summary="@string/yoBlueOnReplyS"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  جهات الاتصال والمجموعات - Contacts & Groups               ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="👥 جهات الاتصال والمجموعات">

        <!-- من يستطيع الاتصال بي -->
        <Preference
            android:icon="@drawable/abo_arab_ic_callme"
            android:layout="@layout/abu_arab_preference_cevron"
            android:key="yoCallsPrivacy"
            android:title="@string/whocancall"
            android:summary="@string/privacy_everyone" />

        <!-- الخصوصية المخصصة لكل محادثة -->
        <com.whatsapp.yo.YoPreference
            android:icon="@drawable/abo_arab_ic_specprivacy"
            android:layout="@layout/abu_arab_preference_cevron"
            android:key="yoCustomPrivList"
            android:title="@string/specificPrivacy"
            android:summary="@string/view_contacts_button"
            app:WaString="true" />

        <!-- إعدادات خصوصية جهات الاتصال -->
        <com.whatsapp.yo.YoPreference
            android:icon="@drawable/abo_arab_ic_privcontac"
            android:layout="@layout/abu_arab_preference_cevron"
            android:key="cat_pc"
            android:title="@string/contacts"
            android:summary="@string/change_privacy_settings"
            app:WaString="true" />

        <!-- إعدادات خصوصية المجموعات -->
        <com.whatsapp.yo.YoPreference
            android:icon="@drawable/abo_arab_ic_privgrup"
            android:layout="@layout/abu_arab_preference_cevron"
            android:key="cat_pg"
            android:title="@string/groups_participation"
            android:summary="@string/change_privacy_settings"
            app:WaString="true" />

        <!-- إعدادات خصوصية البث -->
        <com.whatsapp.yo.YoPreference
            android:icon="@drawable/abo_arab_ic_privtarns"
            android:layout="@layout/abu_arab_preference_cevron"
            android:key="cat_pb"
            android:title="@string/str3379"
            android:summary="@string/change_privacy_settings"
            app:WaString="true" />

    </PreferenceCategory>

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  الأمان والقفل - Security & Lock                          ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="🔑 الأمان والقفل">

        <!-- قفل التطبيق -->
        <Preference
            android:icon="@drawable/abo_arab_ic_lock"
            android:layout="@layout/abu_arab_preference_cevron"
            android:key="app_lock_main"
            android:title="قفل التطبيق"
            android:summary="حماية التطبيق بكلمة مرور أو بصمة أو نقش" />

    </PreferenceCategory>

    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  إعدادات إضافية - Additional Settings                     ║
         ╚══════════════════════════════════════════════════════════════╝ -->
    <PreferenceCategory
        android:layout="@layout/abu_arab_preference_category"
        android:title="⚙️ إعدادات إضافية">

        <!-- إخفاء خيار الخصوصية من القائمة -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_lock"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="Assem_HidePrivacy"
            android:title="@string/abu_arab_hideprivacy"
            android:summary="@string/abu_arab_hideprivacysum"
            android:defaultValue="false" />

        <!-- إخفاء خيار التحديث من القائمة -->
        <SwitchPreference
            android:icon="@drawable/abo_arab_ic_up"
            android:layout="@layout/abu_arab_preference_layout"
            android:key="Assem_HideCUpdates"
            android:title="@string/abu_arab_hidecupdates"
            android:summary="@string/abu_arab_hidecupdatesum"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
