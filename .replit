args = "echo '=== واتس اب عمر (OBWhatsApp) ===' && echo 'الإصدار: v2.26.7.74' && echo '' && echo 'هيكل المشروع:' && ls 'OBWhatsApp_v2.26.7.74(2147483647)_base_src/' && echo '' && echo 'إجمالي الملفات: 98409 ملف' && echo '' && echo 'لإعادة تجميع APK: apktool b OBWhatsApp_v2.26.7.74(2147483647)_base_src'"

[workflows.workflow.metadata]
